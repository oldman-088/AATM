# AATM Environment Configuration Example
# For production deployments, run scripts/ubuntu/install.sh (or scripts/windows/install.ps1)
# to generate cryptographically random secrets into .env.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=

# PostgreSQL (Production) or SQLite (Local Dev)
# DATABASE_URL=postgresql+psycopg://aatm:<POSTGRES_PASSWORD>@127.0.0.1:5432/aatm
# SYNC_DATABASE_URL=postgresql+psycopg://aatm:<POSTGRES_PASSWORD>@127.0.0.1:5432/aatm
DATABASE_URL=sqlite+aiosqlite:///./data/aatm.db
SYNC_DATABASE_URL=sqlite:///./data/aatm.db
POSTGRES_PASSWORD=

# Phase 5 - parallelism. scripts/ubuntu/install.sh starts Postgres + RabbitMQ + Redis with
# docker compose and switches DATABASE_URL to Postgres (pass --sqlite to keep SQLite; >3
# employees on SQLite shows a dashboard warning). All three are optional:
#   no RABBITMQ_URL -> Postgres LISTEN/NOTIFY (on Postgres) or in-process wake bus
#   no REDIS_URL    -> in-process locks / rate limits / event fan-out (single backend process)
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
# RABBITMQ_URL=amqp://aatm:<RABBITMQ_PASSWORD>@127.0.0.1:5672/
# REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0
QUEUE_BACKEND=auto
DEFAULT_ACTIVE_WORKERS=4
AGENT_MAX_PARALLEL=4
AUTO_SCALE_MODE=approval
SCALE_UP_BACKLOG_THRESHOLD=3
SCALE_UP_WAIT_SECONDS=120
SCALE_DOWN_IDLE_MINUTES=30
# Per-provider in-flight limits, e.g. anthropic-claude=4,openai=8 (unset = unlimited)
PROVIDER_CONCURRENCY_LIMITS=

SECRET_KEY=change-this-to-a-secure-random-32-plus-char-secret
DEFAULT_ADMIN_EMAIL=admin@aatm.local
DEFAULT_ADMIN_PASSWORD=change-me-immediately

# AI Provider Credential References (never commit real secrets!)
ARENA_BRIDGE_URL=http://127.0.0.1:4100
ARENA_BRIDGE_TOKEN=
ARENA_BRIDGE_UPSTREAM_URL=
ARENA_BRIDGE_UPSTREAM_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
DAILY_BUDGET_USD=20.0
MONTHLY_BUDGET_USD=100.0
MAX_CONCURRENT_WORKERS=25
MAX_CONCURRENT_BROWSERS=2

# Phase 6 - Arena browser connector. Real Arena stays OFF unless all three are set by the owner
# after Arena's approval. The human signs in to Arena manually in each employee's profile.
ARENA_CONNECTOR_ENABLED=false
ARENA_AUTOMATION_APPROVED=false
ARENA_APPROVAL_REFERENCE=
ARENA_DOMAINS=arena.ai
# Local mock Arena page served by the bridge, for end-to-end tests at any time (loopback only):
# ARENA_MOCK_URL=http://127.0.0.1:4100/mock-arena/
ARENA_MOCK_URL=
ARENA_MIN_REQUEST_INTERVAL_SECONDS=20
ARENA_DAILY_CAP_PER_PROFILE=100
ARENA_REPLY_TIMEOUT_SECONDS=600
# JSON selectors for the real Arena chat page (input, send, assistant_message, user_message, busy)
ARENA_DOM_SELECTORS=

# GitHub Webhook Verification & Execution Sandbox Hardening ("docker" recommended, or "process")
GITHUB_WEBHOOK_SECRET=
AATM_SANDBOX_MODE=docker
AATM_ALLOW_PROCESS_SANDBOX=false
