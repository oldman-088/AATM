# AATM Environment Configuration Example
# For production deployments, run scripts/ubuntu/install.sh (or scripts/windows/install.ps1)
# to generate cryptographically random secrets into .env.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=

# PostgreSQL (Production) or SQLite (Local Dev)
# DATABASE_URL=postgresql+psycopg://aatm:<POSTGRES_PASSWORD>@127.0.0.1:5432/aatm
# SYNC_DATABASE_URL=postgresql+psycopg://aatm:<POSTGRES_PASSWORD>@127.0.0.1:5432/aatm
DATABASE_URL=sqlite+aiosqlite:///./data/aatm.db
SYNC_DATABASE_URL=sqlite:///./data/aatm.db
POSTGRES_PASSWORD=

SECRET_KEY=change-this-to-a-secure-random-32-plus-char-secret
DEFAULT_ADMIN_EMAIL=admin@aatm.local
DEFAULT_ADMIN_PASSWORD=change-me-immediately

# AI Provider Credential References (never commit real secrets!)
ARENA_BRIDGE_URL=http://127.0.0.1:4100
ARENA_BRIDGE_TOKEN=
ANTHROPIC_API_KEY=
DAILY_BUDGET_USD=20.0
MONTHLY_BUDGET_USD=100.0
MAX_CONCURRENT_WORKERS=4
MAX_CONCURRENT_BROWSERS=2

# GitHub Webhook Verification & Execution Sandbox Hardening ("docker" recommended, or "process")
GITHUB_WEBHOOK_SECRET=
AATM_SANDBOX_MODE=docker
AATM_ALLOW_PROCESS_SANDBOX=false
