{
  "version": "2.2.0",
  "api_prefix": "/api/v1",
  "languages": [
    {"code": "en", "name": "English", "nativeName": "English", "dir": "ltr"},
    {"code": "ar", "name": "Arabic", "nativeName": "العربية", "dir": "rtl"},
    {"code": "fa", "name": "Persian", "nativeName": "فارسی", "dir": "rtl"}
  ],
  "divisions": [
    {"id": 1, "code": "D01", "name": "System Foundation and Architecture", "owner": "manager+worker-1"},
    {"id": 2, "code": "D02", "name": "Backend and Database", "owner": "worker-1"},
    {"id": 3, "code": "D03", "name": "Frontend and User Experience", "owner": "worker-2"},
    {"id": 4, "code": "D04", "name": "Multilingual System", "owner": "worker-2"},
    {"id": 5, "code": "D05", "name": "AI Provider Integration", "owner": "worker-3"},
    {"id": 6, "code": "D06", "name": "Browser Profile Infrastructure", "owner": "worker-3"},
    {"id": 7, "code": "D07", "name": "Manager and Worker Agent System", "owner": "worker-4"},
    {"id": 8, "code": "D08", "name": "Task Orchestration and Scheduling", "owner": "worker-4"},
    {"id": 9, "code": "D09", "name": "Project Management and Memory", "owner": "worker-1+worker-4"},
    {"id": 10, "code": "D10", "name": "GitHub and Development Workflows", "owner": "worker-4"},
    {"id": 11, "code": "D11", "name": "Quality, Intelligence, Security and Recovery", "owner": "worker-4"},
    {"id": 12, "code": "D12", "name": "Integration, Cross-Platform Testing and Delivery", "owner": "manager+all"}
  ],
  "enums": {
    "agent_status": ["idle", "working", "paused", "error", "offline"],
    "task_status": ["backlog", "queued", "assigned", "in_progress", "review", "blocked", "completed", "failed", "cancelled"],
    "task_priority": ["critical", "high", "medium", "low"],
    "approval_types": ["branch", "spend", "deploy", "merge", "delete", "credential", "security", "irreversible"],
    "memory_scopes": ["employee", "team", "organization", "global", "project", "agent", "task", "decision"],
    "browser_modes": ["visible", "background"],
    "provider_types": ["arena_local_bridge", "arena_agent", "anthropic_claude"],
    "execution_modes": ["manual", "automatic", "collaborative"],
    "autonomy_modes": ["supervised", "semi_autonomous", "highly_autonomous"],
    "allocation_modes": ["one_per_employee", "shared", "hybrid"],
    "browser_engines": ["playwright", "browser_use", "openbrowser", "automa"],
    "device_statuses": ["online", "degraded", "offline"],
    "message_types": ["task_assignment", "handoff", "status_update", "direct", "group"]
  },
  "entities": {
    "agent": {
      "properties": {
        "reports_to": {"type": ["string", "null"], "maxLength": 64}
      },
      "non_manager_default_reports_to": "manager-0"
    }
  },
  "operations": {
    "device_token_revoke": {
      "method": "POST",
      "path": "/api/v1/devices/{device_id}/revoke",
      "operator_roles": ["admin", "operator"],
      "response": {
        "type": "object",
        "required": ["id", "token_version", "device_token"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "token_version": {"type": "integer", "minimum": 1},
          "device_token": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "providers_usage": {
      "method": "GET",
      "path": "/api/v1/providers/usage",
      "response": {
        "type": "object",
        "required": ["budget_summary", "summary", "logs"],
        "properties": {
          "budget_summary": {
            "type": "object",
            "required": [
              "global_daily_spend_usd",
              "global_monthly_spend_usd",
              "daily_limit_usd",
              "monthly_limit_usd",
              "daily_remaining_usd",
              "monthly_remaining_usd"
            ],
            "additionalProperties": false,
            "properties": {
              "global_daily_spend_usd": {"type": "number"},
              "global_monthly_spend_usd": {"type": "number"},
              "daily_limit_usd": {"type": "number"},
              "monthly_limit_usd": {"type": "number"},
              "daily_remaining_usd": {"type": "number"},
              "monthly_remaining_usd": {"type": "number"}
            }
          },
          "summary": {
            "type": "object",
            "required": ["total_input_tokens", "total_output_tokens", "total_estimated_cost_usd"],
            "additionalProperties": false,
            "properties": {
              "total_input_tokens": {"type": "integer"},
              "total_output_tokens": {"type": "integer"},
              "total_estimated_cost_usd": {"type": "number"}
            }
          },
          "logs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "provider_id",
                "agent_id",
                "model_name",
                "input_tokens",
                "output_tokens",
                "estimated_cost_usd",
                "latency_ms",
                "success",
                "error_message",
                "created_at"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "provider_id": {"type": "string"},
                "agent_id": {"type": ["string", "null"]},
                "model_name": {"type": "string"},
                "input_tokens": {"type": "integer"},
                "output_tokens": {"type": "integer"},
                "estimated_cost_usd": {"type": "number"},
                "latency_ms": {"type": "number"},
                "success": {"type": "boolean"},
                "error_message": {"type": ["string", "null"]},
                "created_at": {"type": "string", "format": "date-time"}
              }
            }
          }
        }
      }
    },
    "provider_test": {
      "method": "POST",
      "path": "/api/v1/providers/{provider_id}/test",
      "request": {
        "type": "object",
        "required": [],
        "properties": {
          "prompt": {"type": "string", "default": "Respond with AATM connectivity verification."},
          "model": {"type": ["string", "null"], "default": null},
          "dry_run": {"type": "boolean", "default": true},
          "agent_id": {"type": ["string", "null"], "default": null},
          "session_id": {"type": ["string", "null"], "default": null}
        }
      }
    },
    "employee_create": {
      "method": "POST",
      "path": "/api/v1/employees",
      "request": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 2, "maxLength": 120},
          "reports_to": {"type": ["string", "null"], "maxLength": 64, "default": null}
        }
      },
      "response": {
        "type": "object",
        "required": ["id", "role", "reports_to"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string"},
          "reports_to": {"type": ["string", "null"]}
        }
      }
    },
    "agent_update": {
      "method": "PATCH",
      "path": "/api/v1/agents/{agent_id}",
      "request": {
        "type": "object",
        "required": [],
        "properties": {
          "reports_to": {"type": ["string", "null"], "maxLength": 64}
        }
      }
    },
    "git_worktree_create": {
      "method": "POST",
      "path": "/api/v1/git/worktrees",
      "operator_roles": ["admin", "operator"],
      "request": {
        "type": "object",
        "required": ["agent_id", "branch_name"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "branch_name": {"type": "string", "minLength": 1, "maxLength": 200},
          "base_ref": {"type": "string", "minLength": 1, "maxLength": 200, "default": "HEAD"},
          "approval_id": {"type": ["string", "null"], "minLength": 1, "default": null}
        }
      },
      "error_responses": {
        "400": "Invalid agent path, branch, base ref, or Git worktree operation.",
        "403": "Caller must be an admin/operator; protected-branch and approval failures are forbidden."
      }
    },
    "git_worktree_remove": {
      "method": "DELETE",
      "path": "/api/v1/git/worktrees/{agent_id}",
      "operator_roles": ["admin", "operator"],
      "path_parameters": {
        "agent_id": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "error_responses": {
        "400": "Invalid agent path or Git worktree removal failed.",
        "403": "Caller must be an admin/operator."
      }
    },
    "execution_traces": {
      "method": "GET",
      "path": "/api/v1/traces",
      "query": {
        "agent_id": {"type": ["string", "null"], "required": false},
        "project_id": {"type": ["string", "null"], "required": false},
        "limit": {"type": "integer", "required": false, "minimum": 1, "maximum": 500, "default": 100}
      },
      "response": {
        "type": "object",
        "required": ["traces", "count", "filters"],
        "properties": {
          "traces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "source", "source_id", "timestamp"],
              "properties": {
                "id": {"type": "string"},
                "source": {"type": "string", "enum": ["audit_log", "provider_usage_log", "workspace_artifact", "agent_message"]},
                "source_id": {"type": "string"},
                "timestamp": {"type": "string", "format": "date-time"},
                "agent_id": {"type": ["string", "null"]},
                "project_id": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          },
          "count": {"type": "integer", "minimum": 0},
          "filters": {
            "type": "object",
            "required": ["agent_id", "project_id"],
            "properties": {
              "agent_id": {"type": ["string", "null"]},
              "project_id": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "github_branch_create": {
      "method": "POST",
      "path": "/api/v1/github/branches",
      "request": {
        "type": "object",
        "required": ["approval_id", "repo", "branch_name", "from_branch"],
        "properties": {
          "approval_id": {"type": "string", "minLength": 1},
          "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
          "branch_name": {"type": "string", "minLength": 1, "maxLength": 255},
          "from_branch": {"type": "string", "minLength": 1, "maxLength": 255}
        }
      }
    },
    "github_pr_create": {
      "method": "POST",
      "path": "/api/v1/github/prs",
      "request": {
        "type": "object",
        "required": ["approval_id", "repo", "title", "head"],
        "properties": {
          "approval_id": {"type": "string", "minLength": 1},
          "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 256},
          "body": {"type": "string", "default": ""},
          "head": {"type": "string", "minLength": 1},
          "base": {"type": "string", "minLength": 1, "default": "main"},
          "draft": {"type": "boolean", "default": false}
        }
      }
    },
    "github_issue_create": {
      "method": "POST",
      "path": "/api/v1/github/issues",
      "request": {
        "type": "object",
        "required": ["approval_id", "repo", "title"],
        "properties": {
          "approval_id": {"type": "string", "minLength": 1},
          "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 256},
          "body": {"type": "string", "default": ""},
          "labels": {"type": "array", "items": {"type": "string"}, "default": []},
          "assignees": {"type": "array", "items": {"type": "string"}, "default": []}
        }
      }
    }
  }
}
